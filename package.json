{
  "name": "revnator-website",
  "version": "1.0.0",
  "description": "Revnator production marketing website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:modules": "cross-env NODE_OPTIONS=--no-deprecation npx tsx src/collections/Modules/seedAllModules.ts",
    "seed:pages": "cross-env NODE_OPTIONS=--no-deprecation npx tsx src/globals/seed-pages.ts",
    "seed:use-cases": "cross-env NODE_OPTIONS=--no-deprecation npx tsx src/scripts/seed-use-cases.ts",
    "seed:industries": "cross-env NODE_OPTIONS=--no-deprecation npx tsx src/scripts/seed-industries.ts",
    "seed:blog": "cross-env NODE_OPTIONS=--no-deprecation npx tsx src/scripts/seed-blog.ts",
    "seed:news": "cross-env NODE_OPTIONS=--no-deprecation npx tsx src/scripts/seed-news.ts",
    "seed:legal": "cross-env NODE_OPTIONS=--no-deprecation npx tsx src/scripts/seed-legal.ts",
    "seed:resources": "cross-env NODE_OPTIONS=--no-deprecation npx tsx src/scripts/seed-resources.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "^3.82.0",
    "@payloadcms/db-postgres": "^3.82.0",
    "@payloadcms/live-preview-react": "^3.82.0",
    "@payloadcms/next": "^3.82.0",
    "@payloadcms/plugin-form-builder": "^3.82.0",
    "@payloadcms/plugin-nested-docs": "^3.82.0",
    "@payloadcms/plugin-redirects": "^3.82.0",
    "@payloadcms/plugin-search": "^3.82.0",
    "@payloadcms/plugin-seo": "^3.82.0",
    "@payloadcms/richtext-lexical": "^3.82.0",
    "@payloadcms/storage-s3": "^3.82.0",
    "@payloadcms/ui": "^3.82.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.0.0",
    "graphql": "^16.8.2",
    "lucide-react": "^0.563.0",
    "next": "^15.3.0",
    "next-sitemap": "^4.2.3",
    "payload": "^3.82.0",
    "prism-react-renderer": "^2.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.71.1",
    "sharp": "^0.34.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
